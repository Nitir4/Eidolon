; -*- coding: utf-8 -*-
; Native per-user installer for the already deployed application payload.
Unicode true
ManifestDPIAware true
RequestExecutionLevel user
SetCompressor /SOLID lzma
Name "Eidolon"
OutFile "@OUTPUT@"
InstallDir "$LOCALAPPDATA\Programs\Eidolon"
InstallDirRegKey HKCU "Software\Eidolon\Installer" "InstallLocation"
VIProductVersion "@VERSION@.0"
VIAddVersionKey "ProductName" "Eidolon"
VIAddVersionKey "FileDescription" "Eidolon per-user setup"
VIAddVersionKey "FileVersion" "@VERSION@"
!include "MUI2.nsh"
!include "x64.nsh"
!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "English"

Function .onInit
  ${IfNot} ${RunningX64}
    MessageBox MB_OK|MB_ICONSTOP "Eidolon requires 64-bit Windows." /SD IDOK
    SetErrorLevel 1
    Abort
  ${EndIf}
  SetRegView 64
FunctionEnd

Section "Install"
  SetRegView 64
  SetShellVarContext current
@INSTALL_FILES@
  SetOutPath "$INSTDIR"
  WriteUninstaller "$INSTDIR\Uninstall.exe"
  CreateDirectory "$SMPROGRAMS\Eidolon"
  CreateShortcut "$SMPROGRAMS\Eidolon\Eidolon.lnk" "$INSTDIR\Eidolon.exe"
  CreateShortcut "$SMPROGRAMS\Eidolon\Uninstall Eidolon.lnk" "$INSTDIR\Uninstall.exe"
  WriteRegStr HKCU "Software\Eidolon\Installer" "InstallLocation" "$INSTDIR"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Eidolon" "DisplayName" "Eidolon"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Eidolon" "DisplayVersion" "@VERSION@"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Eidolon" "InstallLocation" "$INSTDIR"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Eidolon" "UninstallString" '$\"$INSTDIR\Uninstall.exe$\"'
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Eidolon" "QuietUninstallString" '$\"$INSTDIR\Uninstall.exe$\" /S'
  WriteRegDWORD HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Eidolon" "NoModify" 1
  WriteRegDWORD HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Eidolon" "NoRepair" 1
SectionEnd

Section "Uninstall"
  SetRegView 64
  SetShellVarContext current
  SetOutPath "$TEMP"
@REMOVE_FILES@
  ; The original bootstrap image or a scanner may still hold this owned file.
  ; Retry only this exact path; keep registration if cleanup cannot finish.
  StrCpy $0 100
uninstall_remove_self:
  ClearErrors
  Delete "$INSTDIR\Uninstall.exe"
  IfErrors 0 uninstall_self_removed
  IntOp $0 $0 - 1
  IntCmp $0 0 uninstall_self_failed
  Sleep 100
  Goto uninstall_remove_self
uninstall_self_failed:
  SetErrorLevel 1
  MessageBox MB_OK|MB_ICONEXCLAMATION "The uninstaller is still in use. Close other processes using it, then run it again." /SD IDOK
  Quit
uninstall_self_removed:
  RMDir "$INSTDIR"
  Delete "$SMPROGRAMS\Eidolon\Eidolon.lnk"
  Delete "$SMPROGRAMS\Eidolon\Uninstall Eidolon.lnk"
  RMDir "$SMPROGRAMS\Eidolon"
  DeleteRegKey HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Eidolon"
  DeleteRegKey HKCU "Software\Eidolon\Installer"
  DeleteRegKey /ifempty HKCU "Software\Eidolon"
SectionEnd
