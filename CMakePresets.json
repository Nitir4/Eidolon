{
  "version": 5,
  "cmakeMinimumRequired": {"major": 3, "minor": 24, "patch": 0},
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Native desktop development",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "TORA_BUILD_DESKTOP": "ON"
      }
    },
    {
      "name": "headless",
      "inherits": "dev",
      "displayName": "Qt-free core development",
      "binaryDir": "${sourceDir}/build/headless",
      "cacheVariables": {"TORA_BUILD_DESKTOP": "OFF"}
    },
    {
      "name": "ci",
      "displayName": "Common three-OS CI build",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/ci",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release",
        "BUILD_TESTING": "ON",
        "TORA_BUILD_DESKTOP": "ON"
      }
    }
  ],
  "buildPresets": [
    {"name": "dev", "configurePreset": "dev"},
    {"name": "headless", "configurePreset": "headless"},
    {"name": "ci", "configurePreset": "ci", "configuration": "Release"}
  ],
  "testPresets": [
    {"name": "dev", "configurePreset": "dev", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "headless", "configurePreset": "headless", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "ci", "configurePreset": "ci", "configuration": "Release", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}}
  ]
}
